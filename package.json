{
  "name": "escp-room-finder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate && tsc && vite build",
    "preview": "vite preview",
    "validate": "esbuild scripts/validate-graph.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/validate.mjs --log-level=warning && node node_modules/.cache/validate.mjs",
    "seed": "esbuild scripts/seed-supabase.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/seed.mjs --log-level=warning && node node_modules/.cache/seed.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "@vercel/analytics": "^1.5.0",
    "fuse.js": "^7.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "typescript": "^5.2.2",
    "vite": "^5.0.0"
  }
}
